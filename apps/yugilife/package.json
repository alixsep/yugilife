{
  "name": "yugilife",
  "version": "0.0.0",
  "private": true,
  "description": "The Yugilife web app: a free, open-source Yu-Gi-Oh! card maker in the browser, with 14,000+ official cards, full art, rich text, and PNG, JPEG, WebP, and SVG export.",
  "keywords": [
    "yugioh",
    "yu-gi-oh",
    "card-maker",
    "card-generator",
    "custom-cards",
    "tcg",
    "card-editor",
    "full-art",
    "pwa"
  ],
  "homepage": "https://alixsep.github.io/yugilife/",
  "bugs": {
    "url": "https://github.com/alixsep/yugilife/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alixsep/yugilife.git",
    "directory": "apps/yugilife"
  },
  "license": "AGPL-3.0-only",
  "author": "Alixsep (https://github.com/alixsep)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:pin-mask": "node scripts/build-pin-mask.mjs",
    "generate:card-catalog": "node scripts/card-catalog.mjs generate",
    "check:generated": "node scripts/card-catalog.mjs check",
    "build": "tsc -b && vite build && node ../../packages/yugilife-core/scripts/build-fontkit-runtime.mjs dist/assets/fontkit-runtime.js",
    "build:pages": "tsc -b && vite build --mode pages && node ../../packages/yugilife-core/scripts/build-fontkit-runtime.mjs dist/assets/fontkit-runtime.js",
    "preview": "vite preview",
    "preview:pages": "vite preview --base /yugilife/",
    "test": "vitest run",
    "test:unit": "vitest run && node --test scripts/*.test.mjs",
    "test:mask-worker": "pnpm build && node scripts/check-artwork-mask-worker.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "brotli-wasm": "3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "yugilife-core": "workspace:*",
    "yugilife-templates": "workspace:*",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
