{
  "name": "yugilife-cli",
  "version": "0.1.0",
  "description": "Render Yu-Gi-Oh! cards from JSON on the command line, to SVG, PNG, JPEG, or WebP, with the same renderer as the Yugilife website.",
  "keywords": [
    "yugioh",
    "yu-gi-oh",
    "card-maker",
    "card-generator",
    "custom-cards",
    "tcg",
    "cli",
    "svg",
    "renderer"
  ],
  "homepage": "https://alixsep.github.io/yugilife/",
  "bugs": {
    "url": "https://github.com/alixsep/yugilife/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alixsep/yugilife.git",
    "directory": "packages/yugilife-cli"
  },
  "license": "AGPL-3.0-only",
  "author": "Alixsep (https://github.com/alixsep)",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "yugilife-cli": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node ./scripts/make-bin-executable.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:unit": "vitest run --reporter=verbose",
    "verify:packed": "node ./scripts/verify-packed-consumer.mjs"
  },
  "dependencies": {
    "@playwright/browser-chromium": "1.62.0",
    "playwright-core": "1.62.0",
    "yugilife-core": "workspace:*",
    "yugilife-templates": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
